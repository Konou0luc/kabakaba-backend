// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
  VENDOR
}

// Statut de capacité de la vendeuse (cahier, section 24), modifiable par elle à tout moment.
enum VendorCapacity {
  OPEN
  BUSY
  CLOSED
}

enum ComponentUnit {
  PORTION
  UNIT
  PIECE
  BOTTLE
  SACHET
}

enum MenuItemType {
  FIXED
  CUSTOMIZABLE
}

enum OrderStatus {
  CONFIRMED
  IN_PREPARATION
  READY
  RECEIVED
  CANCELLED
}

enum OrderCancelledBy {
  STUDENT
  VENDOR
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionType {
  DEPOSIT
  PAYMENT
  SALE
  REFUND
  WITHDRAWAL
  COMMISSION
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PaymentOperator {
  FLOOZ
  MIXX
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum ConsumptionMode {
  ON_SITE
  TAKEAWAY
}

enum SuspensionStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

model Campus {
  id          String    @id @default(uuid())
  name        String
  city        String
  institution String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users     User[]
  vendors   VendorCampus[]

  @@index([name])
  @@index([city])
}

model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  email              String?   @unique
  password           String?
  firstName          String?
  lastName           String?
  avatarUrl          String?
  role               UserRole  @default(STUDENT)
  campusId           String?
  walletBalance      Int       @default(0)
  isSuspended        Boolean   @default(false)
  suspendedAt        DateTime?
  suspensionUntil    DateTime?
  suspensionReason   String?
  mustChangePassword Boolean   @default(false)
  // Authentification vendeur mobile par code PIN (voir VendorAuthService).
  // pinHash est un bcrypt appliqué NON PAS au PIN brut mais à son HMAC
  // poivré côté serveur : un PIN à 4 chiffres ne représente que 10 000
  // combinaisons, donc une fuite de la base seule ne doit pas suffire à le
  // retrouver hors ligne sans le secret applicatif.
  pinHash            String?
  pinFailedAttempts  Int       @default(0)
  pinLockedUntil     DateTime?
  pinUpdatedAt       DateTime?
  notifyOrders       Boolean   @default(true)
  notifyPromotions   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  campus               Campus?              @relation(fields: [campusId], references: [id])
  orders               Order[]              @relation("StudentOrders")
  cancelledOrders      Order[]              @relation("OrderCancelledByUser")
  transactions         Transaction[]        @relation("TransactionUser")
  reviews              Review[]
  vendor               Vendor?
  ambassador           Ambassador?
  notifications        Notification[]
  devices              Device[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  payments             Payment[]
  affiliate            AmbassadorAffiliate?
  changedOrderStatuses OrderStatusHistory[]
  disputesAsStudent    Dispute[]            @relation("DisputeStudent")
  suspensionEvents     SuspensionEvent[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([campusId])
  @@index([isSuspended])
}

model Vendor {
  id               String    @id @default(uuid())
  userId           String    @unique
  canteenName      String
  logoUrl          String?
  bannerUrl        String?
  description      String?
  balanceFcfa      Decimal   @default(0) @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  capacityStatus   VendorCapacity @default(CLOSED)
  suspendedAt      DateTime?
  suspensionReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user            User             @relation(fields: [userId], references: [id])
  campuses        VendorCampus[]
  menuItems       MenuItem[]
  orders          Order[]
  withdrawals     Withdrawal[]
  reviews         Review[]
  disputes        Dispute[]
  takeawayOptions TakeawayOption[]
  components          Component[]
  componentCategories ComponentCategory[]
  menus               Menu[]

  @@index([canteenName])
  @@index([capacityStatus])
  @@index([isActive])
}

model VendorCampus {
  vendorId String
  campusId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  campus   Campus @relation(fields: [campusId], references: [id])

  @@id([vendorId, campusId])
}

model MenuItem {
  id              String       @id @default(uuid())
  vendorId        String
  name            String
  description     String?
  type            MenuItemType @default(FIXED)
  priceTickets    Int
  imageUrl        String?
  isAvailable     Boolean      @default(true)
  preparationTime Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  vendor     Vendor          @relation(fields: [vendorId], references: [id])
  components MenuComponent[]
  orderItems OrderItem[]
}

model MenuComponent {
  id               String    @id @default(uuid())
  itemId           String
  name             String
  unitPriceTickets Int       @default(0)
  minQty           Int       @default(0)
  maxQty           Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  menuItem            MenuItem             @relation(fields: [itemId], references: [id])
  orderItemComponents OrderItemComponent[]
}

model TakeawayOption {
  id           String    @id @default(uuid())
  vendorId     String
  name         String
  priceTickets Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  vendor Vendor  @relation(fields: [vendorId], references: [id])
  orders Order[]

  @@index([vendorId])
}

// Catégorie de composants définie par la vendeuse (Base, Protéine, Sauce…).
model ComponentCategory {
  id        String    @id @default(uuid())
  vendorId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  components Component[]

  @@index([vendorId])
}

// Composant du stock de la vendeuse. La quantité ne change que par ajustement (delta).
model Component {
  id                String        @id @default(uuid())
  vendorId          String
  categoryId        String?
  name              String
  unit              ComponentUnit
  quantity          Int           @default(0)
  priceTickets      Int           @default(0)
  isAvailable       Boolean       @default(true)
  lowStockThreshold Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  vendor   Vendor             @relation(fields: [vendorId], references: [id])
  category  ComponentCategory? @relation(fields: [categoryId], references: [id])
  menuLines MenuLine[]

  @@index([vendorId])
  @@index([categoryId])
}

// Repas pré-composé : combinaison enregistrée de composants. Ni prix ni disponibilité
// ne sont stockés : ils sont calculés à la lecture à partir des composants.
model Menu {
  id          String    @id @default(uuid())
  vendorId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  vendor Vendor     @relation(fields: [vendorId], references: [id])
  lines  MenuLine[]

  @@index([vendorId])
}

model MenuLine {
  id          String @id @default(uuid())
  menuId      String
  componentId String
  quantity    Int    @default(1)

  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id])

  @@unique([menuId, componentId])
  @@index([componentId])
}

model Order {
  id                 String          @id @default(uuid())
  studentId          String
  vendorId           String
  status             OrderStatus     @default(CONFIRMED)
  totalTickets       Int
  consumptionMode    ConsumptionMode
  takeawayOptionId   String?
  takeawayFeeTickets Int             @default(0)
  cancellationReason String?
  readyAt            DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  cancelledBy        OrderCancelledBy?
  cancelledById      String?
  refundedTickets    Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  student             User                 @relation("StudentOrders", fields: [studentId], references: [id])
  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  takeawayOption      TakeawayOption?      @relation(fields: [takeawayOptionId], references: [id])
  cancelledByUser     User?                @relation("OrderCancelledByUser", fields: [cancelledById], references: [id])
  items               OrderItem[]
  review              Review?
  statusHistory       OrderStatusHistory[]
  relatedTransactions Transaction[]        @relation("TransactionOrder")
  disputes            Dispute[]

  @@index([studentId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([vendorId, status])
  @@index([studentId, status])
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  oldStatus   OrderStatus
  newStatus   OrderStatus
  changedById String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id])
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  itemId    String
  quantity  Int
  unitPrice Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order                @relation(fields: [orderId], references: [id])
  menuItem   MenuItem             @relation(fields: [itemId], references: [id])
  components OrderItemComponent[]
}

model OrderItemComponent {
  id          String   @id @default(uuid())
  orderItemId String
  componentId String
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
  menuComponent MenuComponent @relation(fields: [componentId], references: [id])
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  operator          PaymentOperator
  amountFcfa        Decimal         @db.Decimal(10, 2)
  ticketsReceived   Int
  fedapayReference  String?         @unique
  externalReference String?
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  user                  User                   @relation(fields: [userId], references: [id])
  relatedTransactions   Transaction[]          @relation("TransactionPayment")
  webhookEvents         PaymentWebhookEvent[]
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model PaymentWebhookEvent {
  id               String    @id @default(uuid())
  providerEventKey String    @unique
  paymentId        String
  eventName        String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([receivedAt])
}

model Transaction {
  id               String            @id @default(uuid())
  userId           String
  type             TransactionType
  status           TransactionStatus @default(COMPLETED)
  amount           Decimal           @db.Decimal(10, 2)
  reference        String            @unique
  description      String?
  relatedOrderId   String?
  relatedPaymentId String?
  createdAt        DateTime          @default(now())

  user           User     @relation("TransactionUser", fields: [userId], references: [id])
  relatedOrder   Order?   @relation("TransactionOrder", fields: [relatedOrderId], references: [id])
  relatedPayment Payment? @relation("TransactionPayment", fields: [relatedPaymentId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id                     String           @id @default(uuid())
  vendorId               String
  amount                 Decimal          @db.Decimal(10, 2)
  platformFee            Decimal          @db.Decimal(10, 2)
  operatorFee            Decimal          @db.Decimal(10, 2)
  // Montant exact décrémenté de vendor.balanceFcfa à la création de ce
  // retrait (amount + éventuels frais à la charge du vendeur selon le
  // palier — voir withdrawal-fees.ts::computeWithdrawalFees.debitedFromBalance).
  // Stocké explicitement pour que updateStatus(FAILED) recrédite le montant
  // réel plutôt que de le reconstruire par déduction à partir du barème de
  // frais, qui peut évoluer.
  debitedAmount          Decimal          @db.Decimal(10, 2)
  // Frais réellement retenus par Kabakaba sur ce retrait. Avec le mode
  // manuel, ils ne sont plus payés à FedaPay : ils restent dans la caisse
  // de la plateforme (notamment le barème < 10 000 FCFA).
  feeRetained            Decimal          @default(0) @db.Decimal(10, 2)
  operator               String?
  // Héritage du chantier FedaPay. payoutAmount est désormais le montant
  // exact à envoyer manuellement ; les champs payoutReference/payoutRequestedAt
  // restent conservés pour compatibilité avec les anciennes lignes.
  payoutAmount           Decimal?         @db.Decimal(10, 2)
  payoutReference        String?          @unique
  payoutRequestedAt      DateTime?
  payoutCompletedAt      DateTime?
  acceptedAt             DateTime?
  acceptedByWebUserId    String?
  paidAt                 DateTime?
  cancelledAt            DateTime?
  cancelledByWebUserId   String?
  failureReason          String?
  cancellationReason     String?
  status                 WithdrawalStatus @default(PENDING)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  vendor             Vendor             @relation(fields: [vendorId], references: [id])
  acceptedByWebUser  WebUser?           @relation("WithdrawalAcceptedBy", fields: [acceptedByWebUserId], references: [id])
  cancelledByWebUser WebUser?           @relation("WithdrawalCancelledBy", fields: [cancelledByWebUserId], references: [id])
  proof              WithdrawalProof?

  @@index([status])
  @@index([vendorId, createdAt])
}

model WithdrawalProof {
  id                  String   @id @default(uuid())
  withdrawalId        String   @unique
  uploadedByWebUserId String
  originalName        String
  contentType         String
  sizeBytes           Int
  sha256              String
  data                Bytes
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  withdrawal        Withdrawal @relation(fields: [withdrawalId], references: [id])
  uploadedByWebUser WebUser    @relation(fields: [uploadedByWebUserId], references: [id])

  @@index([uploadedByWebUserId])
}

model Review {
  id        String    @id @default(uuid())
  orderId   String    @unique
  studentId String
  vendorId  String
  rating    Int       @db.SmallInt
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  order   Order  @relation(fields: [orderId], references: [id])
  student User   @relation(fields: [studentId], references: [id])
  vendor  Vendor @relation(fields: [vendorId], references: [id])
}

/// Un simple booléen isSuspended sur User ne suffit pas : il est écrasé à
/// chaque changement et ne garde aucune trace une fois la suspension levée.
/// Ce modèle conserve l'historique complet des suspensions (dates, motifs,
/// auteur de la suspension et de sa levée).
model SuspensionEvent {
  id                   String           @id @default(uuid())
  studentId            String
  student              User             @relation(fields: [studentId], references: [id])
  reason               String
  status               SuspensionStatus @default(ACTIVE)
  suspendedAt          DateTime         @default(now())
  suspendedUntil       DateTime?
  liftedAt             DateTime?
  suspendedByUserId    String?
  suspendedByWebUserId String?
  liftedByUserId       String?
  liftedByWebUserId    String?
  createdAt            DateTime         @default(now())

  @@index([studentId])
  @@index([suspendedAt])
  @@index([status])
}

enum AmbassadorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Ambassador {
  id                 String           @id @default(uuid())
  userId             String           @unique
  promoCode          String?          @unique
  status             AmbassadorStatus @default(PENDING)
  institution        String?
  faculty            String?
  volume30d          Int              @default(0)
  lastReferralAt     DateTime?
  suspendedAt        DateTime?
  treatedByWebUserId String?
  decisionReason     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  user             User                   @relation(fields: [userId], references: [id])
  treatedByWebUser WebUser?               @relation(fields: [treatedByWebUserId], references: [id])
  affiliates       AmbassadorAffiliate[]
}

model AmbassadorAffiliate {
  id           String    @id @default(uuid())
  ambassadorId String
  studentId    String    @unique
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  ambassador Ambassador @relation(fields: [ambassadorId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Device {
  id          String         @id @default(uuid())
  userId      String
  deviceToken String         @unique
  platform    DevicePlatform
  lastUsedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  hashedToken String
  // Regroupe tous les tokens issus d'une même connexion initiale. Permet de
  // révoquer toute la chaîne d'un coup si un token déjà consommé est
  // représenté (signal fort de vol de token — voir refreshTokens() dans
  // auth.service.ts).
  familyId    String    @default(uuid())
  expiresAt   DateTime
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
}

model RateLimitBucket {
  key           String
  throttlerName String
  windowStart   DateTime
  totalHits     Int       @default(0)
  blockedUntil  DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@id([key, throttlerName, windowStart])
  @@index([expiresAt])
}

model AuditLog {
  id        String    @id @default(uuid())
  adminId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  admin     User?    @relation(fields: [adminId], references: [id])
  webUserId String?
  webUser   WebUser? @relation(fields: [webUserId], references: [id])
}

model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  code      String
  attempts  Int       @default(0)
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phone])
  @@index([expiresAt])
}

model WebUser {
  id                 String      @id @default(uuid())
  firstName          String
  lastName           String
  email              String      @unique
  password           String
  role               WebUserRole @default(ADMIN)
  phone              String?
  avatarInitials     String?
  avatarColor        String?
  isActive           Boolean     @default(true)
  isRoot             Boolean     @default(false)
  mustChangePassword Boolean     @default(true)
  twoFaEnabled       Boolean     @default(false)
  twoFaSecret        String?
  tokenVersion       Int         @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  auditLogs                  AuditLog[]
  partnerApplicationsTreated PartnerApplication[]
  disputesTreated            Dispute[]
  ambassadorsTreated         Ambassador[]
  withdrawalsAccepted        Withdrawal[]             @relation("WithdrawalAcceptedBy")
  withdrawalsCancelled       Withdrawal[]             @relation("WithdrawalCancelledBy")
  withdrawalProofsUploaded   WithdrawalProof[]
  deletionRequestsAsTarget   WebUserDeletionRequest[] @relation("DeletionTarget")
  deletionRequestsInitiated  WebUserDeletionRequest[] @relation("DeletionInitiator")
  deletionRequestsConfirmed  WebUserDeletionRequest[] @relation("DeletionConfirmer")

  deletionApprovals WebUserDeletionApproval[]
  backupCodes       WebUserBackupCode[]
  authChallenges    WebAuthChallenge[]

  @@index([email])
  @@index([role])
}

/// Codes de secours 2FA — générés par lot de 10 (crypto.randomBytes) lors
/// de l'activation du 2FA. Un seul usage par code (usedAt marque la
/// consommation). Remplace l'ancien champ unique WebUser.twoFaBackupCode.
model WebAuthChallenge {
  id         String    @id
  webUserId  String
  purpose    String
  step       Int       @default(1)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  webUser WebUser @relation(fields: [webUserId], references: [id])

  @@index([webUserId])
  @@index([expiresAt])
  @@index([purpose, consumedAt])
}

model WebUserBackupCode {
  id        String    @id @default(uuid())
  webUserId String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  webUser WebUser @relation(fields: [webUserId], references: [id])

  @@index([webUserId])
}

enum WebUserDeletionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// Suppression d'un compte WebUser :
/// - Cible ADMIN : exécution immédiate par n'importe quel compte
///   Supervision, tracée (qui, quand) — pas de vote.
/// - Cible SUPERVISION : vote à la majorité des comptes Supervision actifs
///   (hors la cible), fenêtre de 48h — sinon annulation automatique
///   (status EXPIRED). Le vote de l'initiateur est ajouté automatiquement.
/// Le compte root est protégé et ne peut jamais être ciblé.
model WebUserDeletionRequest {
  id                   String                @id @default(uuid())
  targetWebUserId      String
  initiatedByWebUserId String
  confirmedByWebUserId String?
  reason               String?
  status               WebUserDeletionStatus @default(PENDING)
  expiresAt            DateTime
  createdAt            DateTime              @default(now())
  confirmedAt          DateTime?
  cancelledAt          DateTime?

  targetWebUser WebUser                   @relation("DeletionTarget", fields: [targetWebUserId], references: [id])
  initiatedBy   WebUser                   @relation("DeletionInitiator", fields: [initiatedByWebUserId], references: [id])
  confirmedBy   WebUser?                  @relation("DeletionConfirmer", fields: [confirmedByWebUserId], references: [id])
  approvals     WebUserDeletionApproval[]

  @@index([targetWebUserId])
  @@index([status])
}

/// Une ligne par vote "pour" — contrainte unique : un compte ne peut voter
/// qu'une fois par demande. Le vote de l'initiateur est créé automatiquement
/// à la création de la demande.
model WebUserDeletionApproval {
  id         String   @id @default(uuid())
  requestId  String
  approverId String
  createdAt  DateTime @default(now())

  request  WebUserDeletionRequest @relation(fields: [requestId], references: [id])
  approver WebUser                @relation(fields: [approverId], references: [id])

  @@unique([requestId, approverId])
}

enum WebUserRole {
  SUPERVISION
  ADMIN
}

enum PartnerApplicationStatus {
  NEW
  CONTACTED
  ACCEPTED
  REJECTED
}

model PartnerApplication {
  id                 String                   @id @default(uuid())
  structureName      String
  contactName        String
  phone              String
  email              String
  targetCampus       String
  message            String?
  status             PartnerApplicationStatus @default(NEW)
  treatedByWebUserId String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  treatedBy WebUser? @relation(fields: [treatedByWebUserId], references: [id])
}

enum DisputeStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Dispute {
  id                 String           @id @default(uuid())
  orderId            String
  studentId          String
  vendorId           String
  reason             String
  ticketAmount       Int?
  status             DisputeStatus    @default(OPEN)
  treatedByWebUserId String?
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?

  order     Order    @relation(fields: [orderId], references: [id])
  student   User     @relation("DisputeStudent", fields: [studentId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  treatedBy WebUser? @relation(fields: [treatedByWebUserId], references: [id])

  @@index([status])
  @@index([studentId])
  @@index([vendorId])
}
